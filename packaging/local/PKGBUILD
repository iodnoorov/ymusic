# Builds and installs ymusic-cli from this local checkout:
#   cd packaging/local && makepkg -si
pkgname=ymusic-cli
pkgver=3.4.0
pkgrel=1
pkgdesc="Terminal client for Yandex Music: My Wave, likes, stations (TUI)"
arch=('x86_64' 'aarch64')
url="https://github.com/iodnoorov/ymusic"
license=('MIT' 'FDK-AAC')
depends=('libgcc' 'glibc')
optdepends=('pipewire-pulse: share the sound card with other programs (without a sound server sound goes straight to ALSA)'
            'pulseaudio: the same with PulseAudio instead of PipeWire')
makedepends=('cargo')
options=('!lto' '!debug')

_root="$(realpath "$startdir/../..")"

build() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --locked --release
}

package() {
  install -Dm755 "$srcdir/target/release/ymusic" "$pkgdir/usr/bin/ymusic"
  install -Dm644 "$_root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$_root/LICENSE-FDK-AAC" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-FDK-AAC"
  install -Dm644 "$_root/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}

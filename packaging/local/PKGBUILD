# Builds and installs ymusic-cli from this local checkout:
#   cd packaging/local && makepkg -si
pkgname=ymusic-cli
pkgver=0.5.0
pkgrel=1
pkgdesc="Terminal client for Yandex Music: My Wave, likes, stations (TUI); fork of https://github.com/Rexilone/yamusic-cli"
arch=('x86_64' 'aarch64')
url="https://github.com/iodnoorov/ymusic"
license=('MIT')
depends=('mpv' 'libgcc' 'glibc')
makedepends=('cargo')
options=('!lto' '!debug')

_root="$(realpath "$startdir/../..")"

build() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --locked --release
}

package() {
  install -Dm755 "$srcdir/target/release/ymusic" "$pkgdir/usr/bin/ymusic"
  install -Dm644 "$_root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$_root/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
